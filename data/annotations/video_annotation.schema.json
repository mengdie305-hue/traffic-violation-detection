{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/traffic/video_annotation.schema.json",
  "title": "Fixed-camera traffic video annotation",
  "type": "object",
  "required": ["schema_version", "video", "camera", "light_intervals", "tracks", "events", "review"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "video": {
      "type": "object",
      "required": ["id", "file", "fps", "frames", "width", "height", "source_url", "license", "source_sha256", "processed_sha256", "trim", "crop"],
      "properties": {
        "id": {"type": "string"},
        "file": {"type": "string"},
        "fps": {"type": "number", "exclusiveMinimum": 0},
        "frames": {"type": "integer", "minimum": 1},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "source_url": {"type": "string"},
        "license": {"type": "string"},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "processed_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "trim": {
          "type": "object",
          "required": ["source_start_frame", "source_end_frame_exclusive"],
          "properties": {
            "source_start_frame": {"type": "integer", "minimum": 0},
            "source_end_frame_exclusive": {"type": "integer", "minimum": 1}
          }
        },
        "crop": {
          "type": "object",
          "required": ["top", "bottom", "left", "right"],
          "properties": {
            "top": {"type": "integer", "minimum": 0},
            "bottom": {"type": "integer", "minimum": 0},
            "left": {"type": "integer", "minimum": 0},
            "right": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "camera": {
      "type": "object",
      "required": ["calibration_status", "stop_line", "crossing_direction", "traffic_light_rois"],
      "properties": {
        "calibration_status": {"enum": ["pending", "reviewed"]},
        "stop_line": {
          "oneOf": [
            {"type": "null"},
            {"type": "array", "items": {"type": "integer"}, "minItems": 4, "maxItems": 4}
          ]
        },
        "crossing_direction": {
          "type": ["string", "null"],
          "enum": ["upward", "downward", "leftward", "rightward", null]
        },
        "traffic_light_rois": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "bbox", "controls_movement"],
            "properties": {
              "id": {"type": "string"},
              "bbox": {"type": "array", "items": {"type": "integer"}, "minItems": 4, "maxItems": 4},
              "controls_movement": {"type": "string"}
            }
          }
        }
      }
    },
    "light_intervals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["roi_id", "start_frame", "end_frame_exclusive", "state"],
        "properties": {
          "roi_id": {"type": "string"},
          "start_frame": {"type": "integer", "minimum": 0},
          "end_frame_exclusive": {"type": "integer", "minimum": 1},
          "state": {"enum": ["red", "yellow", "green", "unknown"]}
        }
      }
    },
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["track_id", "class", "boxes"],
        "properties": {
          "track_id": {"type": "string"},
          "class": {"enum": ["car", "motorcycle", "bus", "truck", "bicycle", "other"]},
          "boxes": {
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {"type": "integer", "minimum": 0},
                {"type": "number"}, {"type": "number"}, {"type": "number"}, {"type": "number"}
              ],
              "minItems": 5,
              "maxItems": 5
            }
          },
          "plate_text": {"type": "string", "default": "UNKNOWN"}
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_id", "track_id", "type", "key_frame", "light_state", "status"],
        "properties": {
          "event_id": {"type": "string"},
          "track_id": {"type": "string"},
          "type": {"enum": ["red_light", "normal_crossing", "red_light_stop", "uncertain"]},
          "key_frame": {"type": "integer", "minimum": 0},
          "light_state": {"enum": ["red", "yellow", "green", "unknown"]},
          "status": {"enum": ["confirmed", "rejected", "needs_review"]},
          "notes": {"type": "string"}
        }
      }
    },
    "review": {
      "type": "object",
      "required": ["annotation_status", "reviewer", "reviewed_at", "notes"],
      "properties": {
        "annotation_status": {"enum": ["not_started", "in_progress", "reviewed"]},
        "reviewer": {"type": ["string", "null"]},
        "reviewed_at": {"type": ["string", "null"]},
        "notes": {"type": "string"}
      }
    }
  }
}
